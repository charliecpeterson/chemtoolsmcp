&CONTROL
  calculation = "scf", prefix = "slq3", pseudo_dir = ".", outdir = "./qmcprep"
  disk_io = "medium"
/
&SYSTEM
  ibrav = 1, celldm(1) = 24.0, nat = 1, ntyp = 1
  ecutwfc = 80
  tot_charge = 3
  nspin = 2, starting_magnetization(1) = 0.1
  occupations = "smearing", smearing = "gaussian", degauss = 0.007
  assume_isolated = "m-t"
  nbnd = 16
/
&ELECTRONS
  electron_maxstep = 300, mixing_beta = 0.25, conv_thr = 1e-7
/
ATOMIC_SPECIES
Ce 140.116 Ce.secp-sl.UPF
ATOMIC_POSITIONS bohr
Ce 12.0 12.0 12.0
K_POINTS crystal
1
0.0 0.0 0.0 1.0
