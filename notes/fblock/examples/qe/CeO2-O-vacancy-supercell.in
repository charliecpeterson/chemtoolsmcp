&CONTROL
  calculation = "scf", prefix = "ce4o7", pseudo_dir = ".", outdir = "./tmp", disk_io = "none"
/
&SYSTEM
  ibrav = 1, celldm(1) = 10.3074, nat = 11, ntyp = 2
  ecutwfc = 85
  nspin = 2
  starting_magnetization(1) = 0.10
  occupations = "smearing", smearing = "gaussian", degauss = 0.01
/
&ELECTRONS
  electron_maxstep = 250, mixing_beta = 0.3, conv_thr = 1e-7
/
ATOMIC_SPECIES
Ce 140.116 Ce.secp-q.upf
O  15.999  O.dojo-pd04.upf
ATOMIC_POSITIONS crystal
Ce 0.00 0.00 0.00
Ce 0.00 0.50 0.50
Ce 0.50 0.00 0.50
Ce 0.50 0.50 0.00
O  0.25 0.25 0.75
O  0.25 0.75 0.25
O  0.75 0.25 0.25
O  0.25 0.75 0.75
O  0.75 0.25 0.75
O  0.75 0.75 0.25
O  0.75 0.75 0.75
K_POINTS automatic
4 4 4 1 1 1
