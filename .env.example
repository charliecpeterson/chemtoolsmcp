# Per-machine config for the chemtools MCP. Copy to .env and fill in the paths
# for this machine. The launch wrapper (~/mcps/bin/chemtoolsmcp-run) passes this
# file to `uv run --env-file`; the server reads each var from the environment.
# Paths are machine-specific (containers live in different places per host), so
# .env is gitignored and only .env.example is committed.

# Apptainer/Singularity images per program. Omit one to fall back to the
# program's built-in default container path.
CHEMTOOLS_GRASP_CONTAINER=~/mycontainers/grasp2018.sif
CHEMTOOLS_MOLCAS_CONTAINER=~/mycontainers/openmolcas-26.02.sif
CHEMTOOLS_DIRAC_CONTAINER=~/mycontainers/dirac-25.0.sif

# Runner profiles select how jobs execute (local/container/cluster). Without it,
# the MCP runs in analysis-only mode.
CHEMTOOLS_RUNNER_PROFILES=~/.config/chemtools/runner_profiles.yaml
