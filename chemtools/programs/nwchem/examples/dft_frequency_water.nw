start water_freq

title "Water DFT frequency (after geometry opt) — reference template"

echo

# Optimize first, then run analytical frequencies on the same calculation
geometry units angstroms noautosym
  O   0.0000  0.0000  0.1173
  H   0.0000  0.7572 -0.4692
  H   0.0000 -0.7572 -0.4692
end

basis
  * library def2-svp
end

charge 0

dft
  xc b3lyp
  iterations 200
  direct
end

task dft optimize

# Frequencies use the converged geometry from the optimize task above.
task dft frequencies
